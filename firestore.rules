rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Who is who ----
    function signedIn() { return request.auth != null; }

    // Fixed owners (by login email)
    function isMain() {
      return signedIn() && request.auth.token.email == 'talentversebangladesh@gmail.com';
    }

    // A real account whose email is verified (same bar account.html/dashboard.html
    // already use before showing someone's dashboard). Required to post in the forum.
    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    // A counter field moved by exactly +1 or -1 from its old value (missing
    // old value treated as 0, so this works on docs created before the field
    // existed). Used for forum_posts' replyCount/likeCount/heartCount.
    function validCounterBump(field) {
      return request.resource.data[field] is int && request.resource.data[field] >= 0
        && (request.resource.data[field] - resource.data.get(field, 0) == 1
            || request.resource.data[field] - resource.data.get(field, 0) == -1);
    }

    // Official members: the main admin gives each person a list of pages in
    // member_access/{their uid}. Only the main admin can write that document.
    function hasPerm(p) {
      return signedIn()
        && exists(/databases/$(database)/documents/member_access/$(request.auth.uid))
        && (p in get(/databases/$(database)/documents/member_access/$(request.auth.uid)).data.get('permissions', []));
    }

    // Campus Ambassador (CA) counter bump: the +1 must come together (same batch) with a brand-new registration
    // that carries this CA's code, and the code must belong to an active CA.
    function caBumpOk(code) {
      let id = request.resource.data.lastReg;
      return id is string && id.size() > 0
        && request.resource.data.keys().hasOnly(['count','lastReg','lastAt','byEvent'])
        && get(/databases/$(database)/documents/ca_codes/$(code)).data.get('active', false) == true
        && !exists(/databases/$(database)/documents/registrations/$(id))
        && existsAfter(/databases/$(database)/documents/registrations/$(id))
        && getAfter(/databases/$(database)/documents/registrations/$(id)).data.get('refCode', '') == code;
    }

    function nominationsOpen() {
      let s = get(/databases/$(database)/documents/settings/election).data;
      return s.get('nominationsActive', false) == true
        && (s.get('nominationsStart', null) == null || request.time.toMillis() >= s.nominationsStart)
        && (s.get('nominationsEnd', null) == null || request.time.toMillis() <= s.nominationsEnd);
    }

    function isEC() {
      return isMain() || hasPerm('election')
        || (signedIn() && request.auth.token.email == 'ec@talentversebangladesh.com');
    }
    function isFormAdmin() {
      return isMain() || hasPerm('forms')
        || (signedIn() && request.auth.token.email == 'talentversebd5@gmail.com');
    }

    // ---- Public website content: everyone reads, admin / permitted member writes ----
    match /home/{id}          { allow read: if true; allow write: if isMain() || hasPerm('home'); }
    match /gallery/{id}       { allow read: if true; allow write: if isMain() || hasPerm('home'); }
    match /olympiads/{id}     { allow read: if true; allow write: if isMain() || hasPerm('olympiads'); }
    match /team/{id}          { allow read: if true; allow write: if isMain() || hasPerm('team'); }
    match /networkPages/{id}  { allow read: if true; allow write: if isMain() || hasPerm('network'); }
    match /news/{id}          { allow read: if true; allow write: if isMain() || hasPerm('news'); }
    match /quizzes/{id}       { allow read: if true; allow write: if isMain() || hasPerm('quizzes'); }
    // certificates are public (the verify page needs them) but must NEVER contain an email;
    // the owner's email lives in certificate_owners (private)
    match /certificates/{id} {
      allow read: if true;
      allow create, update: if (isMain() || hasPerm('certificates')) && !('email' in request.resource.data);
      allow delete: if isMain() || hasPerm('certificates');
    }
    match /certificate_owners/{id} {
      allow create, update, delete: if isMain() || hasPerm('certificates');
      allow read: if isMain() || hasPerm('certificates')
                  || (signedIn() && resource.data.email == request.auth.token.email);
    }

    // dashboard bell announcements: any signed-in user reads, only admin writes
    match /announcements/{id} { allow read: if signedIn(); allow write: if isMain() || hasPerm('announce'); }

    // email-notification campaign history: only the main admin uses this panel
    match /notification_campaigns/{id} { allow read, write: if isMain() || hasPerm('emailnotify'); }

    // ---- TalentVerse Meet (meet/ pages): rooms are readable by signed-in users; only the main admin
    //      (or members given the "meetings" permission) can create/change/delete rooms. Each person writes only their own attendance row.
    match /meet_rooms/{roomId} {
      allow read: if signedIn();
      allow create, update, delete: if isMain() || hasPerm('meetings');
      match /lobby/{uid} {
        allow create, update: if signedIn() && request.auth.uid == uid && request.resource.data.status == 'waiting';
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow read, update, delete: if isMain() || hasPerm('meetings')
          || (signedIn() && get(/databases/$(database)/documents/meet_rooms/$(roomId)).data.hostEmail == request.auth.token.email.lower());
      }
      match /attendance/{uid} {
        allow create, update: if signedIn() && request.auth.uid == uid;
        allow read: if (signedIn() && request.auth.uid == uid) || isMain() || hasPerm('meetings');
        allow delete: if isMain() || hasPerm('meetings');
      }
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isMain()
                   || (id == 'founder'  && hasPerm('founder'))
                   || (id == 'popup'    && hasPerm('popup'))
                   || ((id == 'certTemplate' || id.matches('certTpl_.*')) && hasPerm('certificates'))
                   || (id == 'election' && isEC())
                   || (id == 'volunteer' && hasPerm('volunteers'));
    }

    // ---- Published results / leaderboard (public top list; written when an admin publishes) ----
    match /quiz_results/{id} {
      allow read: if true;
      allow write: if isMain() || hasPerm('qsubs');
    }

    // ---- Private quiz answer keys: only admins / permitted members ----
    match /quiz_keys/{id} {
      allow read: if isMain() || hasPerm('quizzes') || hasPerm('qsubs');
      allow write: if isMain() || hasPerm('quizzes');
    }

    // ---- Participants' group link: only admins and people registered for that event ----
    match /event_links/{id} {
      allow read: if isMain() || hasPerm('olympiads')
                  || (signedIn() && exists(/databases/$(database)/documents/registration_index/$(id + '_' + request.auth.uid)));
      allow write: if isMain() || hasPerm('olympiads');
    }
    match /registration_index/{docId} {
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && docId == request.resource.data.eventId + '_' + request.auth.uid
                    && request.resource.data.keys().hasOnly(['eventId','uid','at']);
      // id ends with _<uid>: lets a person check their own marker even before it exists
      allow read: if isMain() || hasPerm('registrations') || (signedIn() && docId.matches('.*_' + request.auth.uid));
      allow delete: if isMain() || hasPerm('registrations');
    }

    // ---- Forms ----
    // Full form admins = main admin + the fixed form-admin email. Members with the
    // 'forms' permission can only CREATE forms; they then own those forms, and the
    // owner (or a full admin) can share ONE form with a Member ID (editors list).
    function fullForms() {
      return isMain() || (signedIn() && request.auth.token.email == 'talentversebd5@gmail.com');
    }
    function canEditForm(f) {
      return signedIn() && (f.get('ownerUid', '') == request.auth.uid
                            || request.auth.uid in f.get('editors', []));
    }
    match /custom_forms/{id} {
      allow read: if true;
      allow create: if fullForms()
                    || (hasPerm('forms') && request.resource.data.get('ownerUid', '') == request.auth.uid
                        && request.resource.data.get('editors', []).size() == 0);
      allow update: if fullForms()
                    || (signedIn() && resource.data.get('ownerUid', '') == request.auth.uid
                        && request.resource.data.get('ownerUid', '') == request.auth.uid)
                    || (canEditForm(resource.data)
                        && request.resource.data.get('ownerUid', '') == resource.data.get('ownerUid', '')
                        && request.resource.data.get('editors', []) == resource.data.get('editors', []));
      allow delete: if fullForms()
                    || (signedIn() && resource.data.get('ownerUid', '') == request.auth.uid);
    }
    match /form_responses/{id} {
      allow create: if true;
      allow read, update, delete: if fullForms()
        || (signedIn() && canEditForm(get(/databases/$(database)/documents/custom_forms/$(resource.data.formId)).data));
    }

    // ---- Daily Challenge (Islamic + General Knowledge) & streaks ----
    // question is public; the answer key is readable only after you have answered;
    // an attempt is create-only and its 'correct' flag must match the key; a streak changes only together with an attempt
    function chalAdmin() { return isMain() || hasPerm('challenge'); }
    function attAfter(a) { return getAfter(/databases/$(database)/documents/daily_attempts/$(a)).data; }
    function streakOk(uid) {
      let a = request.resource.data.lastAttempt;
      return request.resource.data.keys().hasOnly(['uid','name','streak','best','points','lastDay','lastAttempt','done','right'])
        && request.resource.data.uid == uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 120
        && a is string
        && !exists(/databases/$(database)/documents/daily_attempts/$(a))
        && existsAfter(/databases/$(database)/documents/daily_attempts/$(a))
        && attAfter(a).uid == uid
        && request.resource.data.streak is int && request.resource.data.best is int
        && request.resource.data.best >= request.resource.data.streak;
    }
    match /daily_challenges/{id} {
      allow read: if true;
      allow write: if chalAdmin();
    }
    match /daily_keys/{id} {
      allow read: if chalAdmin()
                  || (signedIn() && exists(/databases/$(database)/documents/daily_attempts/$(id + '_' + request.auth.uid)));
      allow write: if chalAdmin();
    }
    match /daily_attempts/{id} {
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(['uid','day','sector','choice','correct','at'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.sector in ['islamic','gk']
                    && id == request.resource.data.day + '_' + request.resource.data.sector + '_' + request.auth.uid
                    && request.resource.data.choice is int && request.resource.data.choice >= 0 && request.resource.data.choice <= 3
                    && exists(/databases/$(database)/documents/daily_challenges/$(request.resource.data.day + '_' + request.resource.data.sector))
                    && request.resource.data.correct == (get(/databases/$(database)/documents/daily_keys/$(request.resource.data.day + '_' + request.resource.data.sector)).data.answer == request.resource.data.choice);
      allow read: if chalAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isMain();
    }
    match /streaks/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid && streakOk(uid)
                    && request.resource.data.streak == 1
                    && request.resource.data.points == (attAfter(request.resource.data.lastAttempt).correct == true ? 10 : 0);
      allow update: if signedIn() && request.auth.uid == uid && streakOk(uid)
                    && request.resource.data.streak <= resource.data.streak + 1
                    && request.resource.data.points - resource.data.points == (attAfter(request.resource.data.lastAttempt).correct == true ? 10 : 0);
      allow delete: if isMain();
    }

    // ---- Election ----
    match /election_candidates/{id} { allow read: if true; allow write: if isEC(); }
    match /election_votes/{id} {
      allow create: if true;
      allow read, update, delete: if isEC();
    }
    match /election_voters/{id} {
      allow create: if true;
      allow read, update, delete: if isEC();
    }
    // One nomination per person per round: the app writes to a deterministic
    // doc ID (electionId+email), so a repeat attempt is a Firestore "update",
    // which only the EC can do — that's what blocks a duplicate submission.
    match /election_nominations/{id} {
      // one nomination per person per round (id = round + email, so a 2nd create is really an update = denied)
      allow create: if nominationsOpen()
                    && id.matches('[A-Za-z0-9_]{1,200}')
                    && request.resource.data.keys().hasOnly(['electionId','name','email','phone','position','statement','photo','extra','status','createdAt'])
                    && request.resource.data.status == 'pending'
                    && request.resource.data.name is string && request.resource.data.name.size() <= 120
                    && request.resource.data.email is string && request.resource.data.email.size() <= 200
                    && request.resource.data.phone is string && request.resource.data.phone.size() <= 40
                    && request.resource.data.position is string && request.resource.data.position.size() <= 120
                    && request.resource.data.statement is string && request.resource.data.statement.size() <= 3000
                    && request.resource.data.photo is string
                    && (request.resource.data.photo == '' || request.resource.data.photo.matches('https://.*'))
                    && request.resource.data.get('extra', {}) is map
                    && request.resource.data.get('extra', {}).size() <= 20;
      allow read, update, delete: if isEC();
    }

    // ---- Volunteer / internship applications ----
    match /volunteer_applications/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name','email','phone','type','role','skills','message','availability','resumeLink','extra','status','createdAt'])
                    && request.resource.data.status == 'pending'
                    && request.resource.data.type in ['volunteer','internship']
                    && request.resource.data.name is string && request.resource.data.name.size() <= 120
                    && request.resource.data.email is string && request.resource.data.email.size() <= 200
                    && request.resource.data.phone is string && request.resource.data.phone.size() <= 40
                    && request.resource.data.role is string && request.resource.data.role.size() <= 120
                    && request.resource.data.skills is string && request.resource.data.skills.size() <= 2000
                    && request.resource.data.message is string && request.resource.data.message.size() <= 3000
                    && request.resource.data.availability is string && request.resource.data.availability.size() <= 300
                    && request.resource.data.resumeLink is string && request.resource.data.resumeLink.size() <= 500
                    && request.resource.data.get('extra', {}) is map
                    && request.resource.data.get('extra', {}).size() <= 20;
      allow read, update, delete: if isMain() || hasPerm('volunteers');
    }

    // ---- Discussion forum: everyone reads, only verified accounts post,
    // an author can edit/delete their own post or comment, admin can moderate any ----
    match /forum_posts/{id} {
      allow read: if true;
      // every new post starts 'pending' — the client can never set itself live
      allow create: if verified() && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['authorUid','authorName','authorPhoto','category','title','body','status','replyCount','likeCount','heartCount','createdAt','lastActivityAt'])
                    && request.resource.data.category in ['General','Events','Quiz Help','Announcements']
                    && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200
                    && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 5000
                    && request.resource.data.authorName is string && request.resource.data.authorName.size() <= 120
                    && request.resource.data.status == 'pending'
                    && request.resource.data.replyCount == 0
                    && (!('likeCount' in request.resource.data) || request.resource.data.likeCount == 0)
                    && (!('heartCount' in request.resource.data) || request.resource.data.heartCount == 0);
      // admin: anything (including approve/reject). author: only title/body. any verified member: reply/like/heart counters + activity time
      allow update: if isMain() || hasPerm('forum')
                    || (signedIn() && resource.data.authorUid == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','body'])
                        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200
                        && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 5000)
                    || (verified()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActivityAt','replyCount','likeCount','heartCount'])
                        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['replyCount']) || validCounterBump('replyCount'))
                        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['likeCount']) || validCounterBump('likeCount'))
                        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['heartCount']) || validCounterBump('heartCount')));
      allow delete: if isMain() || hasPerm('forum') || (signedIn() && resource.data.authorUid == request.auth.uid);
    }
    // one reaction doc per (post, person) — overwritten in place to switch type, deleted to un-react
    match /forum_reactions/{id} {
      allow read: if true;
      allow create, update: if verified() && request.resource.data.uid == request.auth.uid
                    && id == (request.resource.data.postId + '_' + request.auth.uid)
                    && request.resource.data.keys().hasOnly(['postId','uid','type','createdAt'])
                    && request.resource.data.postId is string
                    && request.resource.data.type in ['like','heart'];
      allow delete: if isMain() || hasPerm('forum') || (signedIn() && resource.data.uid == request.auth.uid);
    }
    match /forum_comments/{id} {
      allow read: if true;
      // replyTo/replyToAuthor are optional — present only when replying to another comment
      allow create: if verified() && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['postId','authorUid','authorName','authorPhoto','body','replyTo','replyToAuthor','createdAt'])
                    && request.resource.data.postId is string
                    && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 2000
                    && request.resource.data.authorName is string && request.resource.data.authorName.size() <= 120
                    && (!('replyTo' in request.resource.data) || (request.resource.data.replyTo is string && request.resource.data.replyTo.size() <= 200))
                    && (!('replyToAuthor' in request.resource.data) || (request.resource.data.replyToAuthor is string && request.resource.data.replyToAuthor.size() <= 120));
      allow update: if isMain() || hasPerm('forum');
      // the comment's author, or the owner of the post (so deleting your own post can remove its comments)
      allow delete: if isMain() || hasPerm('forum') || (signedIn() && resource.data.authorUid == request.auth.uid)
                    || (signedIn() && exists(/databases/$(database)/documents/forum_posts/$(resource.data.postId))
                        && get(/databases/$(database)/documents/forum_posts/$(resource.data.postId)).data.authorUid == request.auth.uid);
    }

    // ---- Resource Hub: everyone reads; admin / 'resources' members manage; anyone may only bump the download counter by 1 ----
    match /resources/{id} {
      allow read: if true;
      allow create, delete: if isMain() || hasPerm('resources');
      allow update: if isMain() || hasPerm('resources')
                    || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloads'])
                        && request.resource.data.downloads is int
                        && request.resource.data.downloads - resource.data.get('downloads', 0) == 1);
    }

    // ---- Contact messages & registrations ----
    match /messages/{id} {
      allow create: if true;
      allow read, update, delete: if isMain() || hasPerm('messages');
    }
    match /registrations/{id} {
      // a new registration is always 'pending': nobody can approve themselves
      allow create: if !('approval' in request.resource.data) || request.resource.data.approval == 'pending';
      // a participant can read their own registrations (needed for registered-only quizzes)
      allow read: if isMain() || hasPerm('registrations')
                  || (signedIn() && resource.data.email == request.auth.token.email);
      allow update, delete: if isMain() || hasPerm('registrations');
    }

    // ---- Quiz submissions ----
    match /quiz_submissions/{id} {
      allow create: if true;
      allow read: if isMain() || hasPerm('qsubs')
                  || (signedIn() && resource.data.email == request.auth.token.email);
      allow update, delete: if isMain() || hasPerm('qsubs');
    }

    // ---- User accounts: each person only their own, main admin sees all ----
    match /registered_users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid;
      // a Member ID can be set once and never changed afterwards
      allow update: if signedIn() && request.auth.uid == uid
                    && (!('memberCode' in resource.data)
                        || request.resource.data.get('memberCode', null) == resource.data.memberCode);
      allow read: if isMain() || (signedIn() && request.auth.uid == uid);
      allow delete: if isMain();
    }

    // ---- Invite system: a verified new member adds ONE join record under the inviter's Member ID; the inviter (and main admin) can read the list ----
    match /referrals/{code}/joins/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
                    && request.auth.token.email_verified == true
                    && request.resource.data.keys().hasOnly(['uid','name','at'])
                    && request.resource.data.uid == uid
                    && get(/databases/$(database)/documents/registered_users/$(request.auth.uid)).data.get('referredBy', '') == code
                    && get(/databases/$(database)/documents/registered_users/$(request.auth.uid)).data.get('memberCode', '') != code;
      allow read: if isMain()
                  || (signedIn() && get(/databases/$(database)/documents/registered_users/$(request.auth.uid)).data.get('memberCode', '') == code);
      allow update, delete: if isMain();
    }

    // ---- Share counter: each member has one row, bumped by exactly 1 per share; the main admin reads them all ----
    match /share_stats/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['uid','name','email','code','count','lastAt','byKind'])
                    && request.resource.data.uid == uid
                    && request.resource.data.count == 1;
      allow update: if signedIn() && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['uid','name','email','code','count','lastAt','byKind'])
                    && request.resource.data.uid == uid
                    && request.resource.data.count - resource.data.count == 1;
      allow read: if isMain() || (signedIn() && request.auth.uid == uid);
      allow delete: if isMain();
    }

    // ---- Campus Ambassadors: the main admin turns a member into a CA (public: code -> name, so a registration form can check it) ----
    match /ca_codes/{code} {
      allow read: if true;
      allow write: if isMain();
    }
    // per-CA registration count: readable by signed-in members (CAs see their own and the highest), bumped only together with a real registration
    match /ca_counts/{code} {
      allow read: if signedIn();
      allow create: if request.resource.data.count == 1 && caBumpOk(code);
      allow update: if request.resource.data.count - resource.data.count == 1 && caBumpOk(code);
      allow delete: if isMain();
    }

    // ---- Member ID registry: create-only (a code can never be reused or changed) ----
    match /member_codes/{code} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow get: if signedIn();          // look up one Member ID -> uid (for sharing a form)
      allow list, update, delete: if isMain();
    }

    // ---- Member access (page permissions): only the main admin writes ----
    match /member_access/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;   // a member can read their own
      allow read, write: if isMain();
    }

    // ---- Admin activity log: admins & permitted members add entries, only the main admin reads / cleans them ----
    match /admin_logs/{id} {
      allow create: if signedIn()
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.keys().hasOnly(['at','uid','email','section','action','target','details'])
                    && (isMain() || isEC() || isFormAdmin()
                        || exists(/databases/$(database)/documents/member_access/$(request.auth.uid)));
      allow read, delete: if isMain();
    }

    // ---- Anything not listed above is closed ----
    match /{document=**} { allow read, write: if false; }
  }
}
