rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Who is who ----
    function signedIn() { return request.auth != null; }

    // Fixed owners (by login email)
    function isMain() {
      return signedIn() && request.auth.token.email == 'talentversebangladesh@gmail.com';
    }

    // A real account whose email is verified (same bar account.html/dashboard.html
    // already use before showing someone's dashboard). Required to post in the forum.
    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    // Official members: the main admin gives each person a list of pages in
    // member_access/{their uid}. Only the main admin can write that document.
    function hasPerm(p) {
      return signedIn()
        && exists(/databases/$(database)/documents/member_access/$(request.auth.uid))
        && (p in get(/databases/$(database)/documents/member_access/$(request.auth.uid)).data.get('permissions', []));
    }

    function isEC() {
      return isMain() || hasPerm('election')
        || (signedIn() && request.auth.token.email == 'ec@talentversebangladesh.com');
    }
    function isFormAdmin() {
      return isMain() || hasPerm('forms')
        || (signedIn() && request.auth.token.email == 'talentversebd5@gmail.com');
    }

    // ---- Public website content: everyone reads, admin / permitted member writes ----
    match /home/{id}          { allow read: if true; allow write: if isMain() || hasPerm('home'); }
    match /gallery/{id}       { allow read: if true; allow write: if isMain() || hasPerm('home'); }
    match /olympiads/{id}     { allow read: if true; allow write: if isMain() || hasPerm('olympiads'); }
    match /team/{id}          { allow read: if true; allow write: if isMain() || hasPerm('team'); }
    match /networkPages/{id}  { allow read: if true; allow write: if isMain() || hasPerm('network'); }
    match /news/{id}          { allow read: if true; allow write: if isMain() || hasPerm('news'); }
    match /quizzes/{id}       { allow read: if true; allow write: if isMain() || hasPerm('quizzes'); }
    // certificates are public (the verify page needs them) but must NEVER contain an email;
    // the owner's email lives in certificate_owners (private)
    match /certificates/{id} {
      allow read: if true;
      allow create, update: if (isMain() || hasPerm('certificates')) && !('email' in request.resource.data);
      allow delete: if isMain() || hasPerm('certificates');
    }
    match /certificate_owners/{id} {
      allow create, update, delete: if isMain() || hasPerm('certificates');
      allow read: if isMain() || hasPerm('certificates')
                  || (signedIn() && resource.data.email == request.auth.token.email);
    }

    // dashboard bell announcements: any signed-in user reads, only admin writes
    match /announcements/{id} { allow read: if signedIn(); allow write: if isMain() || hasPerm('announce'); }

    // email-notification campaign history: only the main admin uses this panel
    match /notification_campaigns/{id} { allow read, write: if isMain() || hasPerm('emailnotify'); }

    match /settings/{id} {
      allow read: if true;
      allow write: if isMain()
                   || (id == 'founder'  && hasPerm('founder'))
                   || (id == 'popup'    && hasPerm('popup'))
                   || ((id == 'certTemplate' || id.matches('certTpl_.*')) && hasPerm('certificates'))
                   || (id == 'election' && isEC());
    }

    // ---- Published results / leaderboard (public top list; written when an admin publishes) ----
    match /quiz_results/{id} {
      allow read: if true;
      allow write: if isMain() || hasPerm('qsubs');
    }

    // ---- Private quiz answer keys: only admins / permitted members ----
    match /quiz_keys/{id} {
      allow read: if isMain() || hasPerm('quizzes') || hasPerm('qsubs');
      allow write: if isMain() || hasPerm('quizzes');
    }

    // ---- Participants' group link: only admins and people registered for that event ----
    match /event_links/{id} {
      allow read: if isMain() || hasPerm('olympiads')
                  || (signedIn() && exists(/databases/$(database)/documents/registration_index/$(id + '_' + request.auth.uid)));
      allow write: if isMain() || hasPerm('olympiads');
    }
    match /registration_index/{docId} {
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && docId == request.resource.data.eventId + '_' + request.auth.uid
                    && request.resource.data.keys().hasOnly(['eventId','uid','at']);
      allow read: if isMain() || hasPerm('registrations') || (signedIn() && resource.data.uid == request.auth.uid);
      allow delete: if isMain() || hasPerm('registrations');
    }

    // ---- Forms ----
    match /custom_forms/{id}  { allow read: if true; allow write: if isFormAdmin(); }
    match /form_responses/{id} {
      allow create: if true;
      allow read, update, delete: if isFormAdmin();
    }

    // ---- Election ----
    match /election_candidates/{id} { allow read: if true; allow write: if isEC(); }
    match /election_votes/{id} {
      allow create: if true;
      allow read, update, delete: if isEC();
    }
    match /election_voters/{id} {
      allow create: if true;
      allow read, update, delete: if isEC();
    }
    // One nomination per person per round: the app writes to a deterministic
    // doc ID (electionId+email), so a repeat attempt is a Firestore "update",
    // which only the EC can do — that's what blocks a duplicate submission.
    match /election_nominations/{id} {
      allow create: if true;
      allow read, update, delete: if isEC();
    }

    // ---- Volunteer / internship applications ----
    match /volunteer_applications/{id} {
      allow create: if true;
      allow read, update, delete: if isMain() || hasPerm('volunteers');
    }

    // ---- Discussion forum: everyone reads, only verified accounts post,
    // an author can edit/delete their own post or comment, admin can moderate any ----
    match /forum_posts/{id} {
      allow read: if true;
      allow create: if verified() && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if isMain() || hasPerm('forum')
                             || (signedIn() && resource.data.authorUid == request.auth.uid);
    }
    match /forum_comments/{id} {
      allow read: if true;
      allow create: if verified() && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if isMain() || hasPerm('forum')
                             || (signedIn() && resource.data.authorUid == request.auth.uid);
    }

    // ---- Contact messages & registrations ----
    match /messages/{id} {
      allow create: if true;
      allow read, update, delete: if isMain() || hasPerm('messages');
    }
    match /registrations/{id} {
      // a new registration is always 'pending': nobody can approve themselves
      allow create: if !('approval' in request.resource.data) || request.resource.data.approval == 'pending';
      // a participant can read their own registrations (needed for registered-only quizzes)
      allow read: if isMain() || hasPerm('registrations')
                  || (signedIn() && resource.data.email == request.auth.token.email);
      allow update, delete: if isMain() || hasPerm('registrations');
    }

    // ---- Quiz submissions ----
    match /quiz_submissions/{id} {
      allow create: if true;
      allow read: if isMain() || hasPerm('qsubs')
                  || (signedIn() && resource.data.email == request.auth.token.email);
      allow update, delete: if isMain() || hasPerm('qsubs');
    }

    // ---- User accounts: each person only their own, main admin sees all ----
    match /registered_users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid;
      // a Member ID can be set once and never changed afterwards
      allow update: if signedIn() && request.auth.uid == uid
                    && (!('memberCode' in resource.data)
                        || request.resource.data.get('memberCode', null) == resource.data.memberCode);
      allow read: if isMain() || (signedIn() && request.auth.uid == uid);
      allow delete: if isMain();
    }

    // ---- Member ID registry: create-only (a code can never be reused or changed) ----
    match /member_codes/{code} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow get, list, update, delete: if isMain();
    }

    // ---- Member access (page permissions): only the main admin writes ----
    match /member_access/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;   // a member can read their own
      allow read, write: if isMain();
    }

    // ---- Admin activity log: admins & permitted members add entries, only the main admin reads / cleans them ----
    match /admin_logs/{id} {
      allow create: if signedIn()
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.keys().hasOnly(['at','uid','email','section','action','target','details'])
                    && (isMain() || isEC() || isFormAdmin()
                        || exists(/databases/$(database)/documents/member_access/$(request.auth.uid)));
      allow read, delete: if isMain();
    }

    // ---- Anything not listed above is closed ----
    match /{document=**} { allow read, write: if false; }
  }
}
